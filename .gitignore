# Data artifacts. Raw vendor pulls and the per-ticker return matrix are large
# (28MB / 35MB) and fully regenerable, so they stay out of git.
data/raw/
data/processed/*
reports/*.pdf

# ...but the four small artifacts the dashboard reads ARE tracked (~1MB), so
# Streamlit Community Cloud can render the deployed app from a clean clone
# without running the Spark pipeline first.
!data/processed/portfolio_returns.parquet
!data/processed/var_results.parquet
!data/processed/backtest_summary.json
!data/processed/stress_results.json

# portfolio_returns.parquet is a Spark output *directory*; keep the data part
# files, drop Spark's job metadata (pandas reads the directory either way).
data/processed/**/_SUCCESS
data/processed/**/.*.crc

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml

# Spark
spark-warehouse/
derby.log
metastore_db/

# OS / editors
.DS_Store
.idea/
.vscode/
